{
  "name": "micro-app",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS BullMQ demo monorepo",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && nest build demo && nest build bullmq",
    "start:demo": "node dist/apps/demo/apps/demo/src/main.js",
    "start:worker": "node dist/apps/demo/apps/demo/src/worker.main.js",
    "start:dev": "nest start demo --watch",
    "start:worker:dev": "nest start demo --entryFile worker.main --watch",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js \"{apps,libs,test}/**/*.ts\"",
    "lint:fix": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js \"{apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "test": "jest --config jest.config.ts --runInBand",
    "test:demo:unit": "jest --config jest.config.ts --runInBand apps/demo/src/bullmq-demo/services/demo.service.spec.ts",
    "test:demo:controller": "jest --config jest.config.ts --runInBand apps/demo/src/bullmq-demo/controllers/demo.controller.spec.ts",
    "test:unit": "jest --config jest.config.ts --runInBand --testPathIgnorePatterns=integration",
    "test:unit:coverage": "jest --config jest.config.ts --runInBand --testPathIgnorePatterns=integration --coverage --collectCoverageFrom=libs/bullmq/src/services/**/*.ts --collectCoverageFrom=libs/bullmq/src/shared/helpers/**/*.ts",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "build:bullmq": "nest build bullmq",
    "build:database": "nest build database",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "bullmq": "^5.34.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
