{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/demo",
  "compilerOptions": { "webpack": false, "tsConfigPath": "apps/demo/tsconfig.app.json" },
  "projects": {
    "demo": {
      "type": "application",
      "root": "apps/demo",
      "entryFile": "main",
      "sourceRoot": "apps/demo/src",
      "compilerOptions": { "tsConfigPath": "apps/demo/tsconfig.app.json" }
    },
    "bullmq": {
      "type": "library",
      "root": "libs/bullmq",
      "entryFile": "index",
      "sourceRoot": "libs/bullmq/src",
      "compilerOptions": { "tsConfigPath": "libs/bullmq/tsconfig.lib.json" }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": { "tsConfigPath": "libs/database/tsconfig.lib.json" }
    }
  }
}
